# Проект Sanity. Пока не заполнено — сайт работает на встроенных демо-данных
# из src/lib/seed.ts, поэтому репозиторий запускается сразу после npm install.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-03

# ТЕ ЖЕ значения под вторым именем — для Студии.
# Сайт собирает Next.js, Студию собирает Vite, и каждый видит только свою
# приставку. Общего имени, понятного обоим, не существует, поэтому строки
# приходится держать парами. Значение должно совпадать с верхним.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Абсолютный адрес сайта. Нужен для hreflang, og и карты сайта.
NEXT_PUBLIC_SITE_URL=https://otherworldly.example

# Секрет вебхука ревалидации. Задать и в Sanity → API → Webhooks
# как заголовок x-revalidate-secret.
SANITY_REVALIDATE_SECRET=

# Адрес админки. Студия живёт на хостинге Sanity, а не на /studio:
# воркер Cloudflare ограничен 3 МБ, а со встроенной Студией сборка весит 18,5.
NEXT_PUBLIC_STUDIO_URL=https://otherworldly.sanity.studio
