# Проект Sanity. Пока не заполнено — сайт работает на встроенных демо-данных
# из src/lib/seed.ts, поэтому репозиторий запускается сразу после npm install.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-03

# Абсолютный адрес сайта. Нужен для hreflang, og и карты сайта.
NEXT_PUBLIC_SITE_URL=https://otherworldly.example

# Секрет вебхука ревалидации. Задать и в Sanity → API → Webhooks
# как заголовок x-revalidate-secret.
SANITY_REVALIDATE_SECRET=
