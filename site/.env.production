# Значения для СБОРКИ (next build), в том числе локальной перед выкладкой.
# Next.js читает этот файл только в production-режиме, а .env.development —
# только при npm run dev. Так адрес перестаёт зависеть от того, кто и откуда
# собирал: раньше локальная выкладка зашивала в разметку http://localhost:3000,
# и hreflang с картой сайта уводили в никуда.
#
# Секретов здесь нет — это публичный адрес, он и так виден в разметке.
NEXT_PUBLIC_SITE_URL=https://otherworldly.stpetersburg.workers.dev
